# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Configuration
VITE_APP_NAME=Learning Voice App
VITE_APP_VERSION=1.0.0
VITE_APP_URL=http://localhost:5173

# API Configuration
VITE_API_BASE_URL=http://localhost:5173/api
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_VOICE_FEATURES=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false

# Audio/Voice Settings
VITE_MAX_RECORDING_DURATION=300000
VITE_AUDIO_SAMPLE_RATE=44100
VITE_SUPPORTED_AUDIO_FORMATS=webm,mp4,wav

# Session Configuration
VITE_SESSION_TIMEOUT=30
VITE_MAX_INACTIVE_TIME=15

# File Upload Limits
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,audio/wav,audio/mp3,audio/webm

# Language Support
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,zh,ja,ko

# Development Settings (only for development)
VITE_MOCK_API=false
VITE_SKIP_AUTH=false
VITE_LOG_LEVEL=info